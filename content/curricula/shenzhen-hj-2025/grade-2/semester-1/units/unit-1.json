{
  "id": "unit-1",
  "title": "五感小侦探",
  "englishTitle": "What can you do with your five senses?",
  "sourcePages": [2, 3, 4, 5],
  "words": [
    { "id": "u01-word-feel", "text": "feel", "meaning": "感觉；触摸" },
    { "id": "u01-word-see", "text": "see", "meaning": "看见" },
    { "id": "u01-word-smell", "text": "smell", "meaning": "闻" },
    { "id": "u01-word-hear", "text": "hear", "meaning": "听见" },
    { "id": "u01-word-taste", "text": "taste", "meaning": "品尝" },
    { "id": "u01-word-kitten", "text": "kitten", "meaning": "小猫" },
    { "id": "u01-word-puppy", "text": "puppy", "meaning": "小狗" },
    { "id": "u01-word-rabbit", "text": "rabbit", "meaning": "兔子" },
    { "id": "u01-word-flowers", "text": "flowers", "meaning": "花" },
    { "id": "u01-word-egg", "text": "egg", "meaning": "鸡蛋" }
  ],
  "sentences": [
    { "id": "u01-line-01", "text": "I can see a cat.", "meaning": "我能看见一只猫。" },
    { "id": "u01-line-02", "text": "I can hear a cat.", "meaning": "我能听见一只猫。" },
    { "id": "u01-line-03", "text": "What can you see?", "meaning": "你能看见什么？" },
    { "id": "u01-line-04", "text": "Listen!", "meaning": "听！" },
    { "id": "u01-line-05", "text": "You're right.", "meaning": "你说对了。" },
    { "id": "u01-line-06", "text": "I can smell flowers.", "meaning": "我能闻到花香。" },
    { "id": "u01-line-07", "text": "Here!", "meaning": "在这里！" },
    { "id": "u01-line-08", "text": "Now feel this.", "meaning": "现在摸摸这个。" },
    { "id": "u01-line-09", "text": "It's hard.", "meaning": "它是硬的。" },
    { "id": "u01-line-10", "text": "No. Is it a ball?", "meaning": "不。它是一个球吗？" },
    { "id": "u01-line-11", "text": "Is it an egg?", "meaning": "它是一个鸡蛋吗？" },
    { "id": "u01-line-12", "text": "Right!", "meaning": "对！" },
    { "id": "u01-line-13", "text": "Feel this.", "meaning": "摸摸这个。" },
    { "id": "u01-line-14", "text": "Oh, it's soft.", "meaning": "哦，它是软的。" },
    { "id": "u01-line-15", "text": "Wow! It's a big bird!", "meaning": "哇！它是一只大鸟！" },
    { "id": "u01-line-16", "text": "I can hear a kitten.", "meaning": "我能听见一只小猫。" },
    { "id": "u01-line-17", "text": "What can you ...?", "meaning": "你能……什么？" },
    { "id": "u01-line-18", "text": "I can ...", "meaning": "我能……" },
    { "id": "u01-line-19", "text": "It's / They're ...", "meaning": "它是／它们是……" },
    { "id": "u01-line-20", "text": "The blind men and the elephant", "meaning": "盲人与大象" },
    { "id": "u01-line-21", "text": "Come and feel my elephant.", "meaning": "来摸摸我的大象。" },
    { "id": "u01-line-22", "text": "Four blind men sit under a tree.", "meaning": "四个盲人坐在树下。" },
    { "id": "u01-line-23", "text": "No. It's soft.", "meaning": "不，它是软的。" },
    { "id": "u01-line-24", "text": "It's thin.", "meaning": "它是薄的。" },
    { "id": "u01-line-25", "text": "The elephant is hard.", "meaning": "大象是硬的。" },
    { "id": "u01-line-26", "text": "No. It's thick.", "meaning": "不，它是厚的。" },
    { "id": "u01-line-27", "text": "It's ...", "meaning": "它是……" },
    { "id": "u01-line-28", "text": "I have a little cat.", "meaning": "我有一只小猫。" },
    { "id": "u01-line-29", "text": "It's cute and fat.", "meaning": "它可爱又胖。" },
    { "id": "u01-line-30", "text": "Where is my cat?", "meaning": "我的猫在哪里？" },
    { "id": "u01-line-31", "text": "Oh! It's under my hat.", "meaning": "哦！它在我的帽子下面。" },
    { "id": "u01-line-32", "text": "A man wears a cap.", "meaning": "一个男人戴着一顶帽子。" },
    { "id": "u01-line-33", "text": "He has a map.", "meaning": "他有一张地图。" },
    { "id": "u01-line-34", "text": "He takes a nap.", "meaning": "他打个盹。" },
    { "id": "u01-line-35", "text": "Where is his map?", "meaning": "他的地图在哪里？" },
    { "id": "u01-sound-at", "text": "at", "meaning": "at 音" },
    { "id": "u01-sound-ap", "text": "ap", "meaning": "ap 音" },
    { "id": "u01-inst-01", "text": "Listen. Then point and say.", "meaning": "听一听，然后指一指、说一说。" },
    { "id": "u01-inst-02", "text": "Listen and chant.", "meaning": "听一听并唱一唱。" },
    { "id": "u01-inst-03", "text": "Look, point and say.", "meaning": "看一看，指一指、说一说。" },
    { "id": "u01-inst-04", "text": "Guess and circle.", "meaning": "猜一猜并圈出来。" },
    { "id": "u01-inst-05", "text": "What can Daisy see in the show?", "meaning": "Daisy 在表演中能看见什么？" },
    { "id": "u01-inst-06", "text": "Read and check.", "meaning": "读一读并检查。" },
    { "id": "u01-inst-07", "text": "Read and order.", "meaning": "读一读并排序。" },
    { "id": "u01-inst-08", "text": "Role-play.", "meaning": "角色扮演。" },
    { "id": "u01-inst-09", "text": "Colour the picture. Ask and answer.", "meaning": "给图片涂色，问一问、答一答。" },
    { "id": "u01-inst-10", "text": "Think: What can you see in the park?", "meaning": "想一想：你在公园里能看见什么？" },
    { "id": "u01-inst-11", "text": "Think: What can you learn from this story?", "meaning": "想一想：你能从这个故事中学到什么？" },
    { "id": "u01-inst-12", "text": "The Big Question", "meaning": "大问题" },
    { "id": "u01-inst-13", "text": "Sounds", "meaning": "语音" },
    { "id": "u01-inst-14", "text": "What can Daisy see, hear, smell, or feel in the story?", "meaning": "Daisy 在故事中能看见、听见、闻到或感觉到什么？" }
  ]
}
